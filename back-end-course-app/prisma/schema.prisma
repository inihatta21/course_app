// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum StatusValidate {
  VERIFIKASI     @map("verifikasi")
  NOT_VERIFIKASI @map("not_verifikasi")
}

model Users {
  first_name String  @db.VarChar(50)
  last_name  String  @db.VarChar(50)
  email      String  @id @db.VarChar(100)
  password   String
  profile    String?

  @@map("users")
}

model UsersValidate {
  id_user_validate Int            @id @default(autoincrement())
  email            String         @unique @db.VarChar(100)
  kode             String         @db.VarChar(4)
  status           StatusValidate @default(NOT_VERIFIKASI)
  expired_at       DateTime

  @@map("users_validate")
}

model UsersTokenRefresh {
  id_refresh_token_user Int      @id @default(autoincrement())
  token                 String   @unique
  expired_at            DateTime
  create_at             DateTime

  @@map("users_token_refresh")
}

model Course {
  id_course    Int      @id @default(autoincrement())
  mentor       String   @db.VarChar(100)
  id_categorie Int
  judul        String   @db.VarChar(100)
  description  String
  image        String
  harga        Int
  create_at    DateTime

  email     Mentor    @relation(fields: [mentor], references: [email])
  categorie Categorie @relation(fields: [id_categorie], references: [id_categorie])

  @@map("course")
}

model Categorie {
  id_categorie   Int     @id @default(autoincrement())
  nama_categorie String  @unique @db.VarChar(50)
  image_light    String?
  image_dark     String?

  course Course[]

  @@map("categorie")
}

model Mentor {
  email      String  @id @db.VarChar(100)
  first_name String  @db.VarChar(100)
  last_name  String  @db.VarChar(100)
  password   String
  experience String
  profile    String?

  course Course[]

  @@map("mentor")
}
